<%- include('partials/header') %>

<div class="hero-section text-white py-5 mb-4">
  <div class="container text-center py-3">
    <h1 class="display-4 fw-bold mb-3"><i class="bi bi-briefcase-fill me-3"></i>Find Your Perfect Work Experience</h1>
    <p class="lead mb-4">XPSearch connects Year 12 &amp; 13 A-Level students with exciting work experience opportunities at top companies.</p>
    <% if (!user) { %>
      <a href="/auth/register" class="btn btn-light btn-lg me-3">Get Started Free</a>
    <% } %>
    <a href="/jobs" class="btn btn-outline-light btn-lg">Browse Opportunities</a>
  </div>
</div>

<div class="container mb-5">
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <form action="/" method="GET" class="row g-3 align-items-end">
        <div class="col-md-6">
          <label class="form-label fw-semibold">Search Opportunities</label>
          <input type="text" name="keyword" value="<%= keyword %>" class="form-control" placeholder="Job title, company, or keyword..."/>
        </div>
        <div class="col-md-3">
          <label class="form-label fw-semibold">Type</label>
          <select name="paid" class="form-select">
            <option value="">All Opportunities</option>
            <option value="1" <%= paid === '1' ? 'selected' : '' %>>Paid Only</option>
            <option value="0" <%= paid === '0' ? 'selected' : '' %>>Unpaid Only</option>
          </select>
        </div>
        <div class="col-md-3">
          <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search me-2"></i>Search</button>
        </div>
      </form>
    </div>
  </div>

  <h2 class="h4 mb-3 fw-bold">Recent Opportunities</h2>
  <% if (jobs.length === 0) { %>
    <div class="text-center py-5 text-muted">
      <i class="bi bi-inbox display-4 d-block mb-3"></i>
      <p class="lead">No opportunities found. Try adjusting your search.</p>
    </div>
  <% } else { %>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
      <% jobs.forEach(job => { %>
        <div class="col">
          <div class="card h-100 shadow-sm job-card border-0">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <h5 class="card-title mb-0"><%= job.title %></h5>
                <span class="badge <%= job.is_paid ? 'bg-success' : 'bg-secondary' %> ms-2 flex-shrink-0">
                  <%= job.is_paid ? 'Paid' : 'Unpaid' %>
                </span>
              </div>
              <p class="text-muted small mb-1"><i class="bi bi-building me-1"></i><strong><%= job.company_name || job.employer_name %></strong></p>
              <p class="text-muted small mb-2"><i class="bi bi-geo-alt me-1"></i><%= job.location %></p>
              <p class="card-text text-muted small"><%= job.description.substring(0, 120) %><%= job.description.length > 120 ? '...' : '' %></p>
            </div>
            <div class="card-footer bg-transparent border-0 d-flex justify-content-between align-items-center pb-0">
              <small class="text-muted"><i class="bi bi-people me-1"></i><%= job.apply_count %> applicant<%= job.apply_count !== 1 ? 's' : '' %></small>
              <% if (job.deadline) { %><small class="text-muted"><i class="bi bi-calendar me-1"></i><%= job.deadline %></small><% } %>
            </div>
            <div class="card-footer bg-transparent border-0 pt-2">
              <a href="/jobs/<%= job.id %>" class="btn btn-primary btn-sm w-100">View Details <i class="bi bi-arrow-right ms-1"></i></a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
    <div class="text-center mt-4">
      <a href="/jobs" class="btn btn-outline-primary">View All Opportunities <i class="bi bi-arrow-right ms-1"></i></a>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
