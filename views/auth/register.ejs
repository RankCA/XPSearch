<%- include('../partials/header') %>
<div class="xp-auth-wrap">
  <div class="container">
    <div class="xp-auth-card" style="max-width:520px">
      <div class="text-center mb-4">
        <a href="/" class="text-decoration-none">
          <div class="fw-800 fs-4" style="color:var(--xp-primary);letter-spacing:-0.03em">
            <i class="bi bi-briefcase-fill me-1"></i>XPSearch
          </div>
        </a>
      </div>
      <div class="xp-card p-4">
        <h2 class="fw-bold text-center mb-1">Create your account</h2>
        <p class="text-muted text-center mb-4 small">Free for students &amp; employers</p>
        <% if (error) { %>
          <div class="alert alert-danger py-2 small"><i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %></div>
        <% } %>
        <form action="/auth/register" method="POST" id="registerForm">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>

          <div class="mb-3">
            <label class="form-label fw-600 small">Full Name</label>
            <input type="text" name="name" value="<%= formData.name || '' %>" class="form-control" required autocomplete="name" placeholder="Your full name"/>
          </div>
          <div class="mb-3">
            <label class="form-label fw-600 small">Email Address</label>
            <input type="email" name="email" value="<%= formData.email || '' %>" class="form-control" required autocomplete="email" placeholder="you@example.com"/>
          </div>
          <div class="mb-3">
            <label class="form-label fw-600 small">Password</label>
            <input type="password" name="password" class="form-control" required autocomplete="new-password" placeholder="At least 8 characters" minlength="8"/>
          </div>

          <!-- Role selector -->
          <div class="mb-3">
            <label class="form-label fw-600 small">I am a...</label>
            <div class="row g-2">
              <div class="col-6">
                <label class="d-block p-3 rounded-2 border text-center cursor-pointer role-option" for="roleStudent" style="cursor:pointer">
                  <input class="form-check-input d-none" type="radio" name="role" id="roleStudent" value="student"
                    <%= formData.role === 'student' || !formData.role ? 'checked' : '' %> onchange="toggleRoleFields()"/>
                  <div class="fs-3 mb-1">🎓</div>
                  <div class="fw-600 small">Student</div>
                  <div class="text-muted" style="font-size:.7rem">Year 12 or 13</div>
                </label>
              </div>
              <div class="col-6">
                <label class="d-block p-3 rounded-2 border text-center cursor-pointer role-option" for="roleEmployer" style="cursor:pointer">
                  <input class="form-check-input d-none" type="radio" name="role" id="roleEmployer" value="employer"
                    <%= formData.role === 'employer' ? 'checked' : '' %> onchange="toggleRoleFields()"/>
                  <div class="fs-3 mb-1">🏢</div>
                  <div class="fw-600 small">Employer</div>
                  <div class="text-muted" style="font-size:.7rem">Post opportunities</div>
                </label>
              </div>
            </div>
          </div>

          <div id="studentFields" class="mb-3">
            <label class="form-label fw-600 small">Year Group</label>
            <select name="year_group" class="form-select">
              <option value="">Select your year group...</option>
              <option value="12" <%= formData.year_group === '12' ? 'selected' : '' %>>Year 12</option>
              <option value="13" <%= formData.year_group === '13' ? 'selected' : '' %>>Year 13</option>
            </select>
          </div>
          <div id="employerFields" class="mb-3" style="display:none">
            <label class="form-label fw-600 small">Company Name</label>
            <input type="text" name="company_name" value="<%= formData.company_name || '' %>" class="form-control" autocomplete="organization" placeholder="Your company name"/>
          </div>

          <button type="submit" class="btn btn-primary w-100 fw-600 rounded-pill py-2">Create Account — It's Free</button>
        </form>
        <hr class="my-3"/>
        <p class="text-center text-muted small mb-0">
          Already have an account? <a href="/auth/login" class="fw-600">Login here</a>
        </p>
      </div>
    </div>
  </div>
</div>

<style>
.role-option { transition: border-color .15s, background .15s; }
.role-option:has(input:checked) { border-color: var(--xp-primary) !important; background: #eef2ff; }
</style>
<script>
function toggleRoleFields() {
  const isEmployer = document.getElementById('roleEmployer').checked;
  document.getElementById('studentFields').style.display = isEmployer ? 'none' : 'block';
  document.getElementById('employerFields').style.display = isEmployer ? 'block' : 'none';
}
<% if (formData.role === 'employer') { %>toggleRoleFields();<% } %>
</script>
<%- include('../partials/footer') %>
