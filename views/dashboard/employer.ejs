<%- include('../partials/header') %>
<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 fw-bold mb-1"><i class="bi bi-building me-2 text-warning"></i>Employer Dashboard</h1>
      <p class="text-muted mb-0">Welcome back, <strong><%= user.companyName || user.name %></strong>!</p>
    </div>
    <a href="/jobs/new" class="btn btn-primary"><i class="bi bi-plus-circle me-2"></i>Post New Job</a>
  </div>

  <div class="row g-4 mb-4">
    <div class="col-md-4">
      <div class="card border-0 bg-primary text-white shadow-sm">
        <div class="card-body text-center py-4">
          <div class="display-4 fw-bold"><%= jobs.length %></div>
          <div class="mt-1">Total Listings</div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 bg-success text-white shadow-sm">
        <div class="card-body text-center py-4">
          <div class="display-4 fw-bold"><%= jobs.filter(j => j.status === 'open').length %></div>
          <div class="mt-1">Open Listings</div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 bg-info text-white shadow-sm">
        <div class="card-body text-center py-4">
          <div class="display-4 fw-bold"><%= jobs.reduce((sum, j) => sum + j.apply_count, 0) %></div>
          <div class="mt-1">Total Applications</div>
        </div>
      </div>
    </div>
  </div>

  <div class="card shadow-sm border-0">
    <div class="card-header bg-transparent py-3">
      <h5 class="mb-0 fw-bold"><i class="bi bi-briefcase me-2"></i>Your Job Listings</h5>
    </div>
    <div class="card-body p-0">
      <% if (jobs.length === 0) { %>
        <div class="text-center py-5 text-muted">
          <i class="bi bi-briefcase display-4 d-block mb-3"></i>
          <h5>No job listings yet</h5>
          <p>Post your first work experience opportunity to connect with talented A-Level students.</p>
          <a href="/jobs/new" class="btn btn-primary">Post a Job</a>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>Title</th>
                <th>Location</th>
                <th>Type</th>
                <th>Status</th>
                <th>Applications</th>
                <th>Deadline</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% jobs.forEach(job => { %>
                <tr>
                  <td class="fw-semibold"><%= job.title %></td>
                  <td><small><%= job.location %></small></td>
                  <td><span class="badge <%= job.is_paid ? 'bg-success' : 'bg-secondary' %>"><%= job.is_paid ? 'Paid' : 'Unpaid' %></span></td>
                  <td><span class="badge <%= job.status === 'open' ? 'bg-primary' : 'bg-danger' %>"><%= job.status.charAt(0).toUpperCase() + job.status.slice(1) %></span></td>
                  <td>
                    <a href="/jobs/<%= job.id %>" class="badge bg-info text-decoration-none">
                      <i class="bi bi-people me-1"></i><%= job.apply_count %> applicant<%= job.apply_count !== 1 ? 's' : '' %>
                    </a>
                  </td>
                  <td><small class="text-muted"><%= job.deadline || 'None' %></small></td>
                  <td>
                    <div class="d-flex gap-1">
                      <a href="/jobs/<%= job.id %>/edit" class="btn btn-warning btn-sm" title="Edit"><i class="bi bi-pencil"></i></a>
                      <form action="/jobs/<%= job.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this listing?');">
                        <button type="submit" class="btn btn-danger btn-sm" title="Delete"><i class="bi bi-trash"></i></button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
