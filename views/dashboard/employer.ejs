<%- include('../partials/header') %>

<div class="xp-page-header">
  <div class="container d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
      <span class="xp-section-label d-block mb-1">🏢 Employer</span>
      <h1 class="h3 fw-bold mb-0">My Dashboard</h1>
    </div>
    <a href="/jobs/new" class="btn btn-primary rounded-pill px-4"><i class="bi bi-plus-circle me-2"></i>Post New Job</a>
  </div>
</div>

<div class="container py-4">
  <!-- Welcome card -->
  <div class="xp-card p-4 mb-4 d-flex align-items-center gap-3">
    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 fw-800 text-white fs-4"
         style="width:54px;height:54px;background:linear-gradient(135deg,#f59e0b,#d97706)">
      <%= (user.companyName || user.name).charAt(0).toUpperCase() %>
    </div>
    <div>
      <div class="fw-700 fs-5">Hello, <%= user.companyName || user.name %>! 👋</div>
      <div class="text-muted small">Employer account &middot; <a href="/profile">Edit profile</a></div>
    </div>
  </div>

  <!-- Stats -->
  <div class="row g-3 mb-4">
    <div class="col-4">
      <div class="xp-card p-3 text-center">
        <div class="xp-stat-number text-indigo"><%= jobs.length %></div>
        <div class="text-muted small mt-1">Total Listings</div>
      </div>
    </div>
    <div class="col-4">
      <div class="xp-card p-3 text-center">
        <div class="xp-stat-number" style="color:var(--xp-green)"><%= jobs.filter(j=>j.status==='open').length %></div>
        <div class="text-muted small mt-1">Open</div>
      </div>
    </div>
    <div class="col-4">
      <div class="xp-card p-3 text-center">
        <div class="xp-stat-number" style="color:var(--xp-amber)"><%= jobs.reduce((s,j)=>s+j.apply_count,0) %></div>
        <div class="text-muted small mt-1">Applications</div>
      </div>
    </div>
  </div>

  <!-- Listings -->
  <div class="xp-card">
    <div class="p-4 border-bottom">
      <h5 class="fw-700 mb-0"><i class="bi bi-briefcase me-2"></i>Your Job Listings (<%= jobs.length %>)</h5>
    </div>
    <% if (jobs.length === 0) { %>
      <div class="text-center py-5 text-muted">
        <i class="bi bi-briefcase display-1 d-block mb-3 opacity-25"></i>
        <h5 class="fw-semibold">No listings yet</h5>
        <p class="small">Post your first work experience opportunity to connect with A-Level students.</p>
        <a href="/jobs/new" class="btn btn-primary rounded-pill px-4">Post a Job</a>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
          <thead class="table-light">
            <tr>
              <th class="ps-4">Title</th>
              <th class="d-none d-md-table-cell">Location</th>
              <th>Type</th>
              <th>Status</th>
              <th>Applicants</th>
              <th class="d-none d-sm-table-cell">Deadline</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% jobs.forEach(job => { %>
              <tr>
                <td class="ps-4 fw-600"><%= job.title %></td>
                <td class="text-muted small d-none d-md-table-cell"><%= job.location %></td>
                <td>
                  <span class="xp-badge <%= job.is_paid ? 'xp-badge-paid' : 'xp-badge-unpaid' %>">
                    <%= job.is_paid ? 'Paid' : 'Unpaid' %>
                  </span>
                </td>
                <td>
                  <span class="xp-badge <%= job.status==='open' ? 'xp-badge-open' : 'xp-badge-closed' %>">
                    <%= job.status==='open' ? 'Open' : 'Closed' %>
                  </span>
                </td>
                <td>
                  <a href="/jobs/<%= job.id %>" class="text-decoration-none fw-600 small" style="color:var(--xp-primary)">
                    <i class="bi bi-people me-1"></i><%= job.apply_count %>
                  </a>
                </td>
                <td class="text-muted small d-none d-sm-table-cell"><%= job.deadline || '—' %></td>
                <td>
                  <div class="d-flex gap-1">
                    <a href="/jobs/<%= job.id %>/edit" class="btn btn-warning btn-sm rounded-pill px-3" title="Edit">
                      <i class="bi bi-pencil"></i>
                    </a>
                    <form action="/jobs/<%= job.id %>?_method=DELETE" method="POST"
                      onsubmit="return confirm('Delete this listing and all its applications?')">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
                      <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3" title="Delete">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
