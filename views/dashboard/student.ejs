<%- include('../partials/header') %>

<div class="xp-page-header">
  <div class="container d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
      <span class="xp-section-label d-block mb-1">🎓 Student</span>
      <h1 class="h3 fw-bold mb-0">My Dashboard</h1>
    </div>
    <a href="/jobs" class="btn btn-primary rounded-pill px-4"><i class="bi bi-search me-2"></i>Browse Jobs</a>
  </div>
</div>

<div class="container py-4">
  <!-- Welcome -->
  <div class="xp-card p-4 mb-4 d-flex align-items-center gap-3">
    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 fw-800 text-white fs-4"
         style="width:54px;height:54px;background:linear-gradient(135deg,var(--xp-primary),var(--xp-violet))">
      <%= user.name.charAt(0).toUpperCase() %>
    </div>
    <div>
      <div class="fw-700 fs-5">Hello, <%= user.name.split(' ')[0] %>! 👋</div>
      <div class="text-muted small">Year <%= user.yearGroup || '—' %> student &middot; <a href="/profile">Edit profile</a></div>
    </div>
  </div>

  <!-- Stats -->
  <div class="row g-3 mb-4">
    <div class="col-4">
      <div class="xp-card p-3 text-center">
        <div class="xp-stat-number text-indigo"><%= applications.length %></div>
        <div class="text-muted small mt-1">Total Applied</div>
      </div>
    </div>
    <div class="col-4">
      <div class="xp-card p-3 text-center">
        <div class="xp-stat-number" style="color:var(--xp-green)"><%= applications.filter(a=>a.status==='accepted').length %></div>
        <div class="text-muted small mt-1">Accepted</div>
      </div>
    </div>
    <div class="col-4">
      <div class="xp-card p-3 text-center">
        <div class="xp-stat-number" style="color:var(--xp-amber)"><%= applications.filter(a=>a.status==='pending').length %></div>
        <div class="text-muted small mt-1">Pending</div>
      </div>
    </div>
  </div>

  <!-- Applications table -->
  <div class="xp-card">
    <div class="p-4 border-bottom">
      <h5 class="fw-700 mb-0"><i class="bi bi-file-earmark-text me-2"></i>My Applications (<%= applications.length %>)</h5>
    </div>
    <% if (applications.length === 0) { %>
      <div class="text-center py-5 text-muted">
        <i class="bi bi-inbox display-1 d-block mb-3 opacity-25"></i>
        <h5 class="fw-semibold">No applications yet</h5>
        <p class="small">Start browsing and apply to work experience opportunities!</p>
        <a href="/jobs" class="btn btn-primary rounded-pill px-4">Browse Opportunities</a>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
          <thead class="table-light">
            <tr>
              <th class="ps-4">Role</th>
              <th>Company</th>
              <th class="d-none d-md-table-cell">Location</th>
              <th>Type</th>
              <th>Status</th>
              <th class="d-none d-sm-table-cell">Applied</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% applications.forEach(app => { %>
              <tr>
                <td class="ps-4 fw-600"><%= app.job_title %></td>
                <td class="text-muted small"><%= app.company_name %></td>
                <td class="text-muted small d-none d-md-table-cell"><%= app.location %></td>
                <td>
                  <span class="xp-badge <%= app.is_paid ? 'xp-badge-paid' : 'xp-badge-unpaid' %>">
                    <%= app.is_paid ? 'Paid' : 'Unpaid' %>
                  </span>
                </td>
                <td>
                  <span class="xp-badge xp-badge-<%= app.status %>">
                    <% if (app.status==='pending') { %><i class="bi bi-hourglass-split me-1"></i>Pending<% } %>
                    <% if (app.status==='accepted') { %><i class="bi bi-check-circle-fill me-1"></i>Accepted<% } %>
                    <% if (app.status==='rejected') { %><i class="bi bi-x-circle me-1"></i>Not selected<% } %>
                  </span>
                </td>
                <td class="text-muted small d-none d-sm-table-cell"><%= new Date(app.created_at).toLocaleDateString('en-GB') %></td>
                <td>
                  <a href="/jobs/<%= app.job_id %>" class="btn btn-outline-primary btn-sm rounded-pill px-3">View</a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
