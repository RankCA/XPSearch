<%- include('../partials/header') %>

<div class="xp-page-header">
  <div class="container">
    <a href="/jobs" class="btn btn-outline-secondary btn-sm rounded-pill px-3 mb-2">
      <i class="bi bi-arrow-left me-1"></i>Back to Jobs
    </a>
  </div>
</div>

<div class="container py-4">
  <div class="row g-4">

    <!-- ===== Main content ===== -->
    <div class="col-lg-8">
      <div class="xp-card p-4 mb-4">
        <!-- Header row -->
        <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
          <div>
            <h1 class="h2 fw-bold mb-2" style="line-height:1.2"><%= job.title %></h1>
            <p class="text-muted mb-0 fw-500">
              <i class="bi bi-building me-1"></i>
              <strong><%= job.company_name || job.employer_name %></strong>
            </p>
          </div>
          <div class="d-flex flex-column gap-2 flex-shrink-0">
            <span class="xp-badge <%= job.is_paid ? 'xp-badge-paid' : 'xp-badge-unpaid' %> fs-6 px-3 py-2">
              <i class="bi <%= job.is_paid ? 'bi-currency-pound' : 'bi-heart' %>"></i>
              <%= job.is_paid ? 'Paid' : 'Unpaid' %>
            </span>
            <span class="xp-badge <%= job.status === 'open' ? 'xp-badge-open' : 'xp-badge-closed' %>">
              <i class="bi <%= job.status === 'open' ? 'bi-check-circle' : 'bi-lock' %>"></i>
              <%= job.status === 'open' ? 'Accepting Applications' : 'Closed' %>
            </span>
          </div>
        </div>

        <!-- Meta row -->
        <div class="row g-3 mb-4 pb-4 border-bottom">
          <div class="col-6 col-sm-4">
            <div class="d-flex align-items-center gap-2">
              <div class="bg-indigo-soft rounded-2 p-2 text-indigo"><i class="bi bi-geo-alt-fill fs-5"></i></div>
              <div>
                <div class="text-muted" style="font-size:.75rem">Location</div>
                <div class="fw-600 small"><%= job.location %></div>
              </div>
            </div>
          </div>
          <% if (job.salary) { %>
          <div class="col-6 col-sm-4">
            <div class="d-flex align-items-center gap-2">
              <div class="rounded-2 p-2" style="background:#d1fae5;color:#065f46"><i class="bi bi-cash-stack fs-5"></i></div>
              <div>
                <div class="text-muted" style="font-size:.75rem">Salary</div>
                <div class="fw-600 small" style="color:var(--xp-green)"><%= job.salary %></div>
              </div>
            </div>
          </div>
          <% } %>
          <% if (job.deadline) { %>
          <div class="col-6 col-sm-4">
            <div class="d-flex align-items-center gap-2">
              <div class="rounded-2 p-2" style="background:#fee2e2;color:#991b1b"><i class="bi bi-calendar-event fs-5"></i></div>
              <div>
                <div class="text-muted" style="font-size:.75rem">Deadline</div>
                <div class="fw-600 small"><%= job.deadline %></div>
              </div>
            </div>
          </div>
          <% } %>
          <div class="col-6 col-sm-4">
            <div class="d-flex align-items-center gap-2">
              <div class="rounded-2 p-2 bg-light text-muted"><i class="bi bi-clock fs-5"></i></div>
              <div>
                <div class="text-muted" style="font-size:.75rem">Posted</div>
                <div class="fw-600 small"><%= new Date(job.created_at).toLocaleDateString('en-GB') %></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Description -->
        <h5 class="fw-700 mb-2">About this role</h5>
        <p class="text-muted lh-lg" style="white-space:pre-wrap"><%= job.description %></p>

        <% if (job.requirements) { %>
          <h5 class="fw-700 mb-2 mt-4">Requirements</h5>
          <p class="text-muted lh-lg" style="white-space:pre-wrap"><%= job.requirements %></p>
        <% } %>
      </div>

      <!-- Employer: applications list -->
      <% if (user && user.role === 'employer' && user.id === job.employer_id) { %>
        <div class="xp-card">
          <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-700 mb-0"><i class="bi bi-people me-2"></i>Applications (<%= applications.length %>)</h5>
            <% if (applications.length > 0) { %>
              <span class="text-muted small"><%= applications.filter(a=>a.status==='pending').length %> pending</span>
            <% } %>
          </div>
          <% if (applications.length === 0) { %>
            <div class="text-center py-5 text-muted">
              <i class="bi bi-inbox display-4 d-block mb-3 opacity-25"></i>
              <p class="mb-0">No applications yet. Share your listing to attract students!</p>
            </div>
          <% } else { %>
            <div class="list-group list-group-flush">
              <% applications.forEach(app => { %>
                <div class="list-group-item py-3 px-4">
                  <div class="d-flex justify-content-between align-items-start gap-3">
                    <div class="flex-grow-1">
                      <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                        <strong class="fw-600"><%= app.student_name %></strong>
                        <span class="badge bg-light text-dark border" style="font-size:.7rem">Year <%= app.year_group %></span>
                      </div>
                      <% if (app.status === 'accepted') { %>
                        <p class="mb-1 small text-muted"><i class="bi bi-envelope me-1"></i><%= app.student_email %></p>
                      <% } else { %>
                        <p class="mb-1 small text-muted fst-italic"><i class="bi bi-shield-lock me-1"></i>Email visible after accepting</p>
                      <% } %>
                      <% if (app.cover_letter) { %>
                        <p class="mb-1 small text-muted fst-italic lh-base">
                          "<%= app.cover_letter.substring(0, 180) %><%= app.cover_letter.length > 180 ? '…' : '' %>"
                        </p>
                      <% } %>
                      <small class="text-muted">Applied <%= new Date(app.created_at).toLocaleDateString('en-GB') %></small>
                    </div>
                    <div class="d-flex flex-column align-items-end gap-2">
                      <span class="xp-badge xp-badge-<%= app.status %>">
                        <% if (app.status==='pending') { %><i class="bi bi-hourglass-split"></i><% } %>
                        <% if (app.status==='accepted') { %><i class="bi bi-check-circle-fill"></i><% } %>
                        <% if (app.status==='rejected') { %><i class="bi bi-x-circle-fill"></i><% } %>
                        <%= app.status.charAt(0).toUpperCase() + app.status.slice(1) %>
                      </span>
                      <% if (app.status === 'pending') { %>
                        <div class="d-flex gap-1">
                          <form action="/applications/<%= app.id %>/status" method="POST">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
                            <input type="hidden" name="status" value="accepted"/>
                            <button type="submit" class="btn btn-success btn-sm rounded-pill px-3">
                              <i class="bi bi-check-lg me-1"></i>Accept
                            </button>
                          </form>
                          <form action="/applications/<%= app.id %>/status" method="POST">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
                            <input type="hidden" name="status" value="rejected"/>
                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                              <i class="bi bi-x-lg me-1"></i>Reject
                            </button>
                          </form>
                        </div>
                      <% } %>
                    </div>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>

    <!-- ===== Sidebar ===== -->
    <div class="col-lg-4">
      <div class="xp-card p-4 sticky-top" style="top:1rem">
        <% if (!user) { %>
          <h5 class="fw-700 mb-2">Interested in this role?</h5>
          <p class="text-muted small mb-4">Create a free student account to apply for this opportunity.</p>
          <a href="/auth/register" class="btn btn-primary w-100 rounded-pill mb-2 fw-600">
            <i class="bi bi-person-plus me-2"></i>Register to Apply
          </a>
          <a href="/auth/login" class="btn btn-outline-secondary w-100 rounded-pill">Already have an account? Login</a>

        <% } else if (user.role === 'student') { %>
          <% if (job.status !== 'open') { %>
            <div class="text-center py-3">
              <i class="bi bi-lock display-4 d-block mb-2 text-muted opacity-50"></i>
              <p class="text-muted mb-0">This listing is no longer accepting applications.</p>
            </div>
          <% } else if (application) { %>
            <h5 class="fw-700 mb-3">Your Application</h5>
            <div class="text-center py-3">
              <div class="xp-badge xp-badge-<%= application.status %> fs-6 px-3 py-2 mb-3 d-inline-flex">
                <% if (application.status==='pending') { %><i class="bi bi-hourglass-split me-1"></i>Pending Review<% } %>
                <% if (application.status==='accepted') { %><i class="bi bi-check-circle-fill me-1"></i>Accepted 🎉<% } %>
                <% if (application.status==='rejected') { %><i class="bi bi-x-circle me-1"></i>Not selected<% } %>
              </div>
              <% if (application.status === 'accepted') { %>
                <p class="text-muted small">Congratulations! The employer has accepted your application. They'll be in touch soon.</p>
              <% } else if (application.status === 'pending') { %>
                <p class="text-muted small">Your application is under review. Check back here for updates.</p>
              <% } else { %>
                <p class="text-muted small">Unfortunately you weren't selected for this role. Keep applying!</p>
              <% } %>
            </div>
          <% } else { %>
            <h5 class="fw-700 mb-3"><i class="bi bi-send me-2 text-indigo"></i>Apply Now</h5>
            <form action="/applications" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
              <input type="hidden" name="job_id" value="<%= job.id %>"/>
              <div class="mb-3">
                <label class="form-label fw-600 small">Cover Letter <span class="text-muted fw-normal">(optional)</span></label>
                <textarea name="cover_letter" class="form-control" rows="5"
                  placeholder="Tell the employer why you're interested and what makes you a great candidate..."></textarea>
              </div>
              <button type="submit" class="btn btn-primary w-100 rounded-pill fw-600">
                <i class="bi bi-send me-2"></i>Submit Application
              </button>
            </form>
          <% } %>

        <% } else if (user.role === 'employer' && user.id === job.employer_id) { %>
          <h5 class="fw-700 mb-3">Manage Listing</h5>
          <a href="/jobs/<%= job.id %>/edit" class="btn btn-warning w-100 rounded-pill mb-2 fw-600">
            <i class="bi bi-pencil me-2"></i>Edit Job
          </a>
          <form action="/jobs/<%= job.id %>?_method=DELETE" method="POST"
            onsubmit="return confirm('Are you sure you want to delete this listing?')">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
            <button type="submit" class="btn btn-outline-danger w-100 rounded-pill">
              <i class="bi bi-trash me-2"></i>Delete Listing
            </button>
          </form>

        <% } else if (user.role === 'employer') { %>
          <div class="text-center text-muted py-3">
            <i class="bi bi-info-circle display-4 d-block mb-2 opacity-25"></i>
            <p class="small mb-0">You're viewing this as an employer. Only students can apply.</p>
          </div>
        <% } %>
      </div>
    </div>

  </div>
</div>

<%- include('../partials/footer') %>
