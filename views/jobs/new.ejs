<%- include('../partials/header') %>
<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card shadow-sm border-0">
        <div class="card-header bg-transparent py-3">
          <h2 class="h4 fw-bold mb-0"><i class="bi bi-plus-circle me-2 text-primary"></i>Post a New Job Listing</h2>
        </div>
        <div class="card-body p-4">
          <% if (error) { %>
            <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %></div>
          <% } %>
          <form action="/jobs" method="POST">
            <div class="mb-3">
              <label class="form-label fw-semibold">Job Title <span class="text-danger">*</span></label>
              <input type="text" name="title" value="<%= formData.title || '' %>" class="form-control" required placeholder="e.g. Marketing Work Experience"/>
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold">Location <span class="text-danger">*</span></label>
              <input type="text" name="location" value="<%= formData.location || '' %>" class="form-control" required placeholder="e.g. London, Remote, Manchester"/>
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold">Description <span class="text-danger">*</span></label>
              <textarea name="description" class="form-control" rows="5" required placeholder="Describe the role, what the student will be doing, duration, etc."><%= formData.description || '' %></textarea>
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold">Requirements <span class="text-muted fw-normal">(optional)</span></label>
              <textarea name="requirements" class="form-control" rows="3" placeholder="Any specific skills, interests, or qualifications required..."><%= formData.requirements || '' %></textarea>
            </div>
            <div class="mb-3">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="isPaid" name="is_paid" value="1" <%= formData.is_paid === '1' ? 'checked' : '' %> onchange="toggleSalary()"/>
                <label class="form-check-label fw-semibold" for="isPaid">This is a paid opportunity</label>
              </div>
            </div>
            <div class="mb-3" id="salaryField" style="display: <%= formData.is_paid === '1' ? 'block' : 'none' %>;">
              <label class="form-label fw-semibold">Salary / Pay Rate</label>
              <input type="text" name="salary" value="<%= formData.salary || '' %>" class="form-control" placeholder="e.g. £10/hour, £200/week"/>
            </div>
            <div class="mb-4">
              <label class="form-label fw-semibold">Application Deadline <span class="text-muted fw-normal">(optional)</span></label>
              <input type="date" name="deadline" value="<%= formData.deadline || '' %>" class="form-control"/>
            </div>
            <div class="d-flex gap-2">
              <button type="submit" class="btn btn-primary fw-semibold"><i class="bi bi-check-circle me-2"></i>Post Job Listing</button>
              <a href="/dashboard" class="btn btn-outline-secondary">Cancel</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
function toggleSalary() {
  document.getElementById('salaryField').style.display = document.getElementById('isPaid').checked ? 'block' : 'none';
}
</script>
<%- include('../partials/footer') %>
