<%- include('../partials/header') %>

<div class="xp-page-header">
  <div class="container">
    <span class="xp-section-label d-block mb-1">Employer</span>
    <h1 class="h3 fw-bold mb-0"><i class="bi bi-plus-circle me-2 text-indigo"></i>Post a New Opportunity</h1>
  </div>
</div>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="xp-card p-4">
        <% if (error) { %>
          <div class="alert alert-danger py-2 small mb-4"><i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %></div>
        <% } %>
        <form action="/jobs" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>

          <div class="row g-3 mb-3">
            <div class="col-md-8">
              <label class="form-label fw-600 small">Job Title <span class="text-danger">*</span></label>
              <input type="text" name="title" value="<%= formData.title || '' %>" class="form-control" required maxlength="200" placeholder="e.g. Marketing Work Experience"/>
            </div>
            <div class="col-md-4">
              <label class="form-label fw-600 small">Location <span class="text-danger">*</span></label>
              <input type="text" name="location" value="<%= formData.location || '' %>" class="form-control" required placeholder="e.g. London, Remote"/>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label fw-600 small">Description <span class="text-danger">*</span></label>
            <textarea name="description" class="form-control" rows="5" required maxlength="10000"
              placeholder="Describe the role, what the student will be doing, the duration, team they'll join, etc."><%= formData.description || '' %></textarea>
          </div>

          <div class="mb-3">
            <label class="form-label fw-600 small">Requirements <span class="text-muted fw-normal">(optional)</span></label>
            <textarea name="requirements" class="form-control" rows="3" maxlength="5000"
              placeholder="Any specific skills, interests, or subjects useful for this role..."><%= formData.requirements || '' %></textarea>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label fw-600 small">Compensation</label>
              <div class="xp-card p-3">
                <div class="form-check form-switch mb-2">
                  <input class="form-check-input" type="checkbox" id="isPaid" name="is_paid" value="1"
                    <%= formData.is_paid === '1' ? 'checked' : '' %> onchange="toggleSalary()"/>
                  <label class="form-check-label fw-600 small" for="isPaid">This is a paid opportunity</label>
                </div>
                <div id="salaryField" style="display:<%= formData.is_paid === '1' ? 'block' : 'none' %>">
                  <input type="text" name="salary" value="<%= formData.salary || '' %>" class="form-control form-control-sm"
                    placeholder="e.g. £10/hour, £200/week"/>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-600 small">Application Deadline <span class="text-muted fw-normal">(optional)</span></label>
              <input type="date" name="deadline" value="<%= formData.deadline || '' %>" class="form-control"/>
            </div>
          </div>

          <div class="d-flex gap-2 pt-2">
            <button type="submit" class="btn btn-primary rounded-pill px-4 fw-600">
              <i class="bi bi-check-circle me-2"></i>Post Listing
            </button>
            <a href="/dashboard" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
function toggleSalary() {
  document.getElementById('salaryField').style.display = document.getElementById('isPaid').checked ? 'block' : 'none';
}
</script>
<%- include('../partials/footer') %>
