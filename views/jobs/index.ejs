<%- include('../partials/header') %>

<!-- Page header -->
<div class="xp-page-header">
  <div class="container d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
      <span class="xp-section-label d-block mb-1">Discover</span>
      <h1 class="h3 fw-bold mb-0">Browse Opportunities</h1>
    </div>
    <% if (user && user.role === 'employer') { %>
      <a href="/jobs/new" class="btn btn-primary rounded-pill px-4"><i class="bi bi-plus-circle me-2"></i>Post a Job</a>
    <% } else if (!user) { %>
      <a href="/auth/register" class="btn btn-primary rounded-pill px-4"><i class="bi bi-person-plus me-2"></i>Register to Apply</a>
    <% } %>
  </div>
</div>

<div class="container py-4">
  <!-- Search bar -->
  <div class="xp-card p-3 mb-4">
    <form action="/jobs" method="GET" class="row g-2 align-items-center">
      <div class="col-md-6">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
          <input type="text" name="keyword" value="<%= keyword %>" class="form-control border-start-0 ps-0" placeholder="Search by title, company, or keyword..."/>
        </div>
      </div>
      <div class="col-md-3">
        <select name="paid" class="form-select">
          <option value="">All Types</option>
          <option value="1" <%= paid === '1' ? 'selected' : '' %>>💰 Paid Only</option>
          <option value="0" <%= paid === '0' ? 'selected' : '' %>>🤝 Unpaid Only</option>
        </select>
      </div>
      <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-fill rounded-pill"><i class="bi bi-search me-1"></i>Search</button>
        <% if (keyword || paid) { %>
          <a href="/jobs" class="btn btn-outline-secondary rounded-pill px-3" title="Clear filters"><i class="bi bi-x-lg"></i></a>
        <% } %>
      </div>
    </form>
  </div>

  <!-- Results -->
  <% if (jobs.length === 0) { %>
    <div class="text-center py-5 text-muted">
      <i class="bi bi-inbox display-1 d-block mb-3 opacity-25"></i>
      <h5 class="fw-semibold">No opportunities found</h5>
      <p class="small mb-3">Try adjusting your search filters or check back soon.</p>
      <% if (keyword || paid) { %>
        <a href="/jobs" class="btn btn-outline-primary btn-sm rounded-pill">Clear filters</a>
      <% } %>
    </div>
  <% } else { %>
    <p class="text-muted small mb-3">
      <strong><%= jobs.length %></strong> opportunit<%= jobs.length !== 1 ? 'ies' : 'y' %> found
      <% if (keyword) { %> for "<strong><%= keyword %></strong>"<% } %>
    </p>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
      <% jobs.forEach(job => { %>
        <div class="col">
          <div class="xp-card xp-card-hover h-100 d-flex flex-column">
            <div class="p-4 flex-grow-1">
              <div class="d-flex justify-content-between align-items-start mb-3">
                <span class="xp-badge <%= job.is_paid ? 'xp-badge-paid' : 'xp-badge-unpaid' %>">
                  <i class="bi <%= job.is_paid ? 'bi-currency-pound' : 'bi-heart' %>"></i>
                  <%= job.is_paid ? 'Paid' : 'Unpaid' %>
                </span>
                <% if (job.deadline) { %>
                  <small class="text-muted"><i class="bi bi-calendar3 me-1"></i><%= job.deadline %></small>
                <% } %>
              </div>
              <h5 class="fw-700 mb-1" style="line-height:1.3"><%= job.title %></h5>
              <p class="text-muted small mb-1 fw-500">
                <i class="bi bi-building me-1"></i><%= job.company_name || job.employer_name %>
              </p>
              <p class="text-muted small mb-3">
                <i class="bi bi-geo-alt me-1"></i><%= job.location %>
              </p>
              <% if (job.salary) { %>
                <p class="small fw-600 mb-2" style="color:var(--xp-green)">
                  <i class="bi bi-currency-pound me-1"></i><%= job.salary %>
                </p>
              <% } %>
              <p class="text-muted small mb-0 lh-base">
                <%= job.description.substring(0, 100) %><%= job.description.length > 100 ? '…' : '' %>
              </p>
            </div>
            <div class="px-4 pb-4 pt-2 border-top d-flex justify-content-between align-items-center">
              <small class="text-muted"><i class="bi bi-people me-1"></i><%= job.apply_count %> applicant<%= job.apply_count !== 1 ? 's' : '' %></small>
              <a href="/jobs/<%= job.id %>" class="btn btn-primary btn-sm rounded-pill px-3">View</a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
