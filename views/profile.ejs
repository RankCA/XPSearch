<%- include('partials/header') %>

<div class="xp-page-header">
  <div class="container">
    <span class="xp-section-label d-block mb-1">Account</span>
    <h1 class="h3 fw-bold mb-0">My Profile</h1>
  </div>
</div>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-7">

      <!-- Profile info card -->
      <div class="xp-card p-4 mb-4">
        <div class="d-flex align-items-center gap-3 mb-4">
          <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 fw-800 text-white fs-3"
               style="width:64px;height:64px;background:linear-gradient(135deg,var(--xp-primary),var(--xp-violet))">
            <%= user.name.charAt(0).toUpperCase() %>
          </div>
          <div>
            <div class="fw-700 fs-5"><%= user.name %></div>
            <div class="text-muted small">
              <% if (user.role === 'student') { %>
                🎓 Year <%= profile.year_group %> Student
              <% } else { %>
                🏢 Employer &mdash; <%= profile.company_name %>
              <% } %>
            </div>
            <div class="text-muted small"><i class="bi bi-envelope me-1"></i><%= profile.email %></div>
          </div>
        </div>

        <!-- Update name -->
        <h6 class="fw-700 mb-3 text-muted text-uppercase" style="font-size:.72rem;letter-spacing:.08em">Update Details</h6>
        <% if (nameError) { %>
          <div class="alert alert-danger py-2 small mb-3"><i class="bi bi-exclamation-triangle-fill me-2"></i><%= nameError %></div>
        <% } %>
        <form action="/profile" method="POST" class="mb-0">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
          <input type="hidden" name="action" value="update_name"/>
          <div class="row g-2 align-items-end">
            <div class="col">
              <label class="form-label fw-600 small">Display Name</label>
              <input type="text" name="name" value="<%= profile.name %>" class="form-control" required autocomplete="name"/>
            </div>
            <% if (user.role === 'employer') { %>
            <div class="col">
              <label class="form-label fw-600 small">Company Name</label>
              <input type="text" name="company_name" value="<%= profile.company_name || '' %>" class="form-control" autocomplete="organization"/>
            </div>
            <% } %>
            <div class="col-auto">
              <button type="submit" class="btn btn-primary rounded-pill px-3">Save</button>
            </div>
          </div>
        </form>
      </div>

      <!-- Change password -->
      <div class="xp-card p-4 mb-4">
        <h6 class="fw-700 mb-3 text-muted text-uppercase" style="font-size:.72rem;letter-spacing:.08em">Change Password</h6>
        <% if (pwError) { %>
          <div class="alert alert-danger py-2 small mb-3"><i class="bi bi-exclamation-triangle-fill me-2"></i><%= pwError %></div>
        <% } %>
        <form action="/profile" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
          <input type="hidden" name="action" value="change_password"/>
          <div class="mb-3">
            <label class="form-label fw-600 small">Current Password</label>
            <input type="password" name="current_password" class="form-control" required autocomplete="current-password"/>
          </div>
          <div class="mb-3">
            <label class="form-label fw-600 small">New Password</label>
            <input type="password" name="new_password" class="form-control" required minlength="8" autocomplete="new-password" placeholder="At least 8 characters"/>
          </div>
          <button type="submit" class="btn btn-outline-primary rounded-pill px-4">Update Password</button>
        </form>
      </div>

      <!-- Delete account (Right to Erasure) -->
      <div class="xp-card p-4 border-danger" style="border-left:3px solid var(--bs-danger)">
        <h6 class="fw-700 mb-2 text-danger text-uppercase" style="font-size:.72rem;letter-spacing:.08em">
          <i class="bi bi-exclamation-triangle me-1"></i>Delete Account
        </h6>
        <p class="text-muted small mb-3">
          Permanently delete your account and all associated data (applications, job listings, and personal information).
          This action cannot be undone. Under UK GDPR, this is your <strong>right to erasure</strong>.
        </p>
        <button class="btn btn-outline-danger btn-sm rounded-pill px-3" type="button"
          data-bs-toggle="collapse" data-bs-target="#deleteConfirm">
          <i class="bi bi-trash me-1"></i>I want to delete my account
        </button>
        <div class="collapse mt-3" id="deleteConfirm">
          <div class="alert alert-danger py-2 small mb-3">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Warning:</strong> This will permanently delete your account, all your
            <% if (user.role === 'employer') { %>job listings and received applications<% } else { %>applications<% } %>,
            and all personal data. Enter your password to confirm.
          </div>
          <form action="/profile" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
            <input type="hidden" name="action" value="delete_account"/>
            <div class="mb-3">
              <label class="form-label fw-600 small">Confirm your password</label>
              <input type="password" name="confirm_password" class="form-control" required autocomplete="current-password"/>
            </div>
            <button type="submit" class="btn btn-danger rounded-pill px-4"
              onclick="return confirm('Are you absolutely sure? All your data will be permanently deleted.')">
              <i class="bi bi-trash me-1"></i>Permanently Delete My Account
            </button>
          </form>
        </div>
      </div>

    </div>
  </div>
</div>

<%- include('partials/footer') %>
