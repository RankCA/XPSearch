# XPSearch Environment Variables
# Copy this file to .env and fill in the values for your environment.
# The .env file is gitignored and must never be committed to version control.

# Session secret - use a long random string (e.g. openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-long-random-secret

# CSRF protection secret - use a separate long random string
CSRF_SECRET=change-me-to-a-different-long-random-secret

# Node environment: development | production
NODE_ENV=development

# Port to listen on (default: 3000)
PORT=3000
